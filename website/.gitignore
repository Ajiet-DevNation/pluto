# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reference images and local-only drafts never belong in a commit.
# Ignored sprites in public/ ARE copied into a local static export: do not
# deploy that export if the sprites must remain private.
/.private-assets/
/designref/
/app/pluton*.png
/public/pluton*.png
/public/pluto-*.png
/components/architecture.tsx
/components/capabilities.tsx
/components/discord-example.tsx
/components/footer.tsx
/components/hero.tsx
/components/navbar.tsx
/components/pipeline.tsx
/components/smooth-scroll.tsx
/components/sources.tsx
/components/space-showcase.tsx
/components/story.tsx
/components/trust.tsx
/content/
