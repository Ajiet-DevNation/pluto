NODE_ENV=development
PORT=3000

# GitHub
# Prefer a read-only fine-grained PAT (public repositories, Contents/Issues/Metadata: Read).
# GITHUB_APP_ID + GITHUB_PRIVATE_KEY become the production credential once the App exists.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# Miro (read-only)
MIRO_ACCESS_TOKEN=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=1422593925658579036
# The bot's own surface. Never used as a citation source.
DISCORD_OUTPUT_CHANNEL_ID=1570721649538502686

# Database
DATABASE_URL=

# Cloudflare Workers AI (embeddings, generation, transcription)
# Verified 2026-11-13: bge-base-en-v1.5 returns 768 dimensions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Evidence gate — owned by .planning/contracts/search.md
EVIDENCE_MIN_SCORE=0.4
