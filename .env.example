NODE_ENV=development
PORT=3000

# GitHub
# Prefer the installed read-only GitHub App for full public-org coverage.
# Auto prefers complete App credentials and falls back to GITHUB_TOKEN.
# Set to `pat` or `app` to force one credential path.
GITHUB_AUTH_MODE=auto
GITHUB_TOKEN=
GITHUB_APP_ID=
# Installation ID from the organization's App installation URL.
GITHUB_INSTALLATION_ID=
# Prefer a protected key file; never commit the PEM or put its contents here.
GITHUB_PRIVATE_KEY_PATH=
# Optional secret-manager injection only; do not store PEM contents in repository files.
GITHUB_PRIVATE_KEY=

# Miro (read-only)
MIRO_ACCESS_TOKEN=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=1422593925658579036
# The bot's own surface. Never used as a citation source.
DISCORD_OUTPUT_CHANNEL_ID=1570721649538502686

# Database
DATABASE_URL=

# Upload auth — static shared secret for v1 (per-user auth comes with P3)
UPLOAD_TOKEN=

# Cloudflare Workers AI (embeddings, generation, transcription)
# Verified 2026-11-13: bge-base-en-v1.5 returns 768 dimensions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Evidence gate — owned by .planning/contracts/search.md
EVIDENCE_MIN_SCORE=0.4
